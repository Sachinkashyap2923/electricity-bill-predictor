# Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database Configuration (Defaults to SQLite in instance/electricity.db)
# To use MySQL: mysql+pymysql://user:password@localhost:3306/electricity_db
DATABASE_URL=sqlite:///instance/electricity.db

# Server Configuration
PORT=5000
HOST=127.0.0.1
